<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <!-- Needed to talk to the backend. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed for the study reminder notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearningSide">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LearningSide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.momentum.admin.AdminPanel"
            android:exported="false"
            />
        <activity
            android:name=".admin.UserTab"
            android:exported="false"
            />
        <activity
            android:name=".admin.SystemActivity"
            android:exported="false"
            />
        <activity
            android:name=".admin.EngagementAnalytics"
            android:exported="false"
            />
        <activity
            android:name=".admin.CourseManagement"
            android:exported="false"
            />
        <activity
            android:name=".admin.BadgeManagement"
            android:exported="false" />
        <activity
            android:name=".admin.LearnTechSettings"
            android:exported="false" />
        <activity
            android:name=".admin.DataExport"
            android:exported="false" />

        <!-- Extra screens, with a navy top bar like the admin screens -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:label="Log in"
            android:theme="@style/Theme.LearningSide.Page.NoBar" />
        <activity
            android:name=".activities.SignupActivity"
            android:exported="false"
            android:label="Create account"
            android:theme="@style/Theme.LearningSide.Page.NoBar" />
        <activity
            android:name=".activities.AchievementsActivity"
            android:exported="false"
            android:label="Achievements"
            android:theme="@style/Theme.LearningSide.Page" />
        <activity
            android:name=".activities.MomentumMapActivity"
            android:exported="false"
            android:label="Momentum Map"
            android:theme="@style/Theme.LearningSide.Page" />
        <activity
            android:name=".activities.CertificateActivity"
            android:exported="false"
            android:label="Certificate"
            android:theme="@style/Theme.LearningSide.Page" />
        <activity
            android:name=".activities.RemindersActivity"
            android:exported="false"
            android:label="Reminders"
            android:theme="@style/Theme.LearningSide.Page" />
        <activity
            android:name=".activities.StudyCoachActivity"
            android:exported="false"
            android:label="Study Coach"
            android:theme="@style/Theme.LearningSide.Page" />
        <activity
            android:name=".activities.MomentumCoachActivity"
            android:exported="false"
            android:label="Momentum Coach"
            android:theme="@style/Theme.LearningSide.Page" />
        <activity
            android:name=".activities.StudyTimetableActivity"
            android:exported="false"
            android:label="Study Timetable"
            android:theme="@style/Theme.LearningSide.Page" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Theme.LearningSide.Page.NoBar" />
        <activity
            android:name=".activities.LearnTechActivity"
            android:exported="false"
            android:label="LearnTech"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.LearningSide.Page" />

        <!-- Shows the daily study reminder notification -->
        <receiver
            android:name=".activities.ReminderReceiver"
            android:exported="false" />


    </application>


</manifest>
