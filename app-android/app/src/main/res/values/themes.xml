<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Momentum" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Momentum" parent="Base.Theme.Momentum" />

    <style name="Theme.LearningSide"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

    </style>

    <!-- The extra screens: navy top bar like the admin screens, pale grey page,
         purple rounded buttons. -->
    <style name="Theme.LearningSide.Page"
        parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/ltm_navy</item>
        <item name="colorPrimaryVariant">@color/ltm_navy</item>
        <item name="colorOnPrimary">@color/ltm_white</item>
        <item name="colorSecondary">@color/ltm_blue</item>
        <item name="android:windowBackground">@color/ltm_background</item>
        <item name="materialButtonStyle">@style/Widget.LearningSide.Button</item>
    </style>

    <!-- The same, without the top bar, for Log in and Sign up, which have their
         own logo and title. -->
    <style name="Theme.LearningSide.Page.NoBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/ltm_navy</item>
    </style>

    <style name="Widget.LearningSide.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/ltm_blue</item>
    </style>
</resources>
