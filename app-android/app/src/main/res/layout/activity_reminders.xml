
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Study Reminders"
            android:textColor="#071D35"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Build a learning habit, one day at a time."
            android:textColor="#687783"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰"
                android:textSize="48sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your daily study time"
                android:textColor="#071D35"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvReminderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6:00 PM"
                android:textColor="#7666E8"
                android:textSize="34sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnChooseTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Time"
                android:textAllCaps="false"
                android:backgroundTint="#EDEAFF"
                android:textColor="#071D35"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSetReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set Daily Reminder"
                android:textAllCaps="false"
                android:backgroundTint="#7666E8"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCancelReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel Reminder"
                android:textAllCaps="false"
                android:backgroundTint="#FDEBE0"
                android:textColor="#E46C28" />

            <TextView
                android:id="@+id/tvReminderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No reminder scheduled yet."
                android:textColor="#687783"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="20dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnReminderBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:backgroundTint="#071D35"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
